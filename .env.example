# Required server-side secret. Paste a DeepSeek API key in .env.local or Vercel.
OPENAI_API_KEY=

# Optional defaults and OpenAI-compatible endpoint overrides.
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-flash

# Optional shared quota. Missing or unavailable Redis uses process memory.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Optional public build-time configuration.
# Vercel's production project domain supplies the default canonical origin.
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-recurring-payment-link

# Optional server-side webhooks for durable lead and funnel collection.
# LEAD_WEBHOOK_URL=https://your-webhook.example/lead
# FUNNEL_WEBHOOK_URL=https://your-webhook.example/funnel
